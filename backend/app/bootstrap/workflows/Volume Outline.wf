# Workflow: Volume Outline
# Function: When a volume outline is saved, create characters, scenes, stages, and the writing guide
# Trigger: Automatically triggered when a volume outline card is saved

#@node(description="Trigger: listen for volume outline card save")
trigger = Trigger.CardSaved(card_type="Volume Outline")
#</node>


#@node(description="Read the volume outline")
volume = Card.Read(card_id=trigger.card_id)
#</node>


#@node(description="Extract the new character list")
new_characters = Logic.Expression(
    expression="volume.content.new_character_cards or []"
  )
#</node>


#@node(async=true, description="Batch-create character cards (async)")
char_cards = Card.BatchUpsert(
    project_id=trigger.project_id,
    parent_id=trigger.card_id,
    card_type="Character Card",
    title_template="{item.name}",
    items=new_characters.result
  )
#</node>


#@node(description="Extract the new scene list")
new_scenes = Logic.Expression(
    expression="volume.content.new_scene_cards or []"
  )
#</node>


#@node(async=true, description="Batch-create scene cards (async)")
scene_cards = Card.BatchUpsert(
    project_id=trigger.project_id,
    parent_id=trigger.card_id,
    card_type="Scene Card",
    title_template="{item.name}",
    items=new_scenes.result
  )
#</node>


#@node(description="Generate the stage list")
stages = Logic.Expression(
    expression="[{'index': i, 'volume_number': volume.content.volume_number} for i in range(1, (volume.content.stage_count or 0) + 1)]"
  )
#</node>


#@node(async=true, description="Batch-create stage outlines (async)")
stage_cards = Card.BatchUpsert(
    project_id=trigger.project_id,
    parent_id=trigger.card_id,
    card_type="Stage Outline",
    title_template="Stage {item.index}",
    content_template={
      "stage_number": "{item.index}",
      "volume_number": "{item.volume_number}"
    },
    items=stages.result
  )
#</node>


#@node(description="Create the writing guide (wrapped as a list)")
guide_item = Logic.Expression(
    expression="[volume.content]"
  )
#</node>


#@node(async=true, description="Batch-create writing guides (async)")
guide_card = Card.BatchUpsert(
    project_id=trigger.project_id,
    parent_id=trigger.card_id,
    card_type="Writing Guide",
    title_template="Writing Guide",
    content_template="{item}",
    items=guide_item.result
  )
#</node>


#@node(description="Wait for all async tasks to complete")
wait_result = Logic.Wait(tasks=[char_cards, scene_cards, stage_cards, guide_card])
#</node>


#@node(description="Clear the temporary lists")
update_result = Card.Update(
    card_id=trigger.card_id,
    content_merge={
      "new_character_cards": [],
      "new_scene_cards": []
    }
  )
#</node>